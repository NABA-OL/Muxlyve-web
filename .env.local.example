# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Repo de la app en GitHub (owner/repo) — para leer la última release
GITHUB_REPO=tu-usuario/Multi_Stream

# Token de GitHub (opcional) — sube el rate limit de 60 a 5000 req/hora
GITHUB_TOKEN=

# --- Fase 3: Pagos + licencias ---
# Freemius webhook secret key
FREEMIUS_SECRET_KEY=

# Neon Postgres (DATABASE_URL ya en Vercel — copiar aquí para dev local)
DATABASE_URL=

# Secreto HMAC para guardar las claves de licencia hasheadas en la BD.
# Generar con: openssl rand -hex 32. Definirlo ANTES de tener licencias reales:
# cambiarlo después invalida las claves ya guardadas (hay que re-hashearlas).
KEY_HASH_SECRET=

# Resend — envío de correos
RESEND_API_KEY=
RESEND_FROM=noreply@tudominio.com

# --- Fase 3.5: Admin ---
# Token simple para proteger /admin (cambiarlo en producción)
ADMIN_TOKEN=

# --- Notificaciones por Telegram (reportes, feedback, compras) ---
# Token del bot (@BotFather). Puede ser el mismo bot que ya usa la app de escritorio.
TELEGRAM_BOT_TOKEN=
# ID del chat/grupo donde llegan las notificaciones (número, puede ser negativo si es grupo).
TELEGRAM_CHAT_ID=
# Opcionales: si el grupo tiene Topics activado, el ID de cada topic separa
# reportes/feedback/compras en su propio hilo. Sin estos, todo llega al chat general.
TELEGRAM_TOPIC_REPORTS=
TELEGRAM_TOPIC_FEEDBACK=
TELEGRAM_TOPIC_PURCHASES=
TELEGRAM_TOPIC_RELEASES=

# Secret compartido con el webhook de GitHub (Settings del repo de la app →
# Webhooks → Add webhook → evento "Releases" → mismo secret acá).
GITHUB_WEBHOOK_SECRET=

# Secret pa' validar que los updates entrantes del bot vengan de Telegram.
# Genera uno random y regístralo junto con la URL del webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://tudominio.com/api/telegram/webhook" \
#     -d "secret_token=<este mismo valor>"
TELEGRAM_WEBHOOK_SECRET=

# Vercel Blob (store público "muxlyve-blob") — fotos de perfil de licencias.
# Se conecta solo al vincular el store al proyecto en Vercel (prefijo BLOB_MUXLYVE).
BLOB_MUXLYVE_READ_WRITE_TOKEN=

# Traducción automática del blog (opcional). Sin esta variable, el botón
# "Traducir" del panel queda deshabilitado y las entradas se cargan a mano.
ANTHROPIC_API_KEY=
